rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(teamId) { return signedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)); }
    function admin(teamId) { return member(teamId) && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'admin'; }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;

      match /contacts/{contactUid} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
      }

      match /chatFolders/{folderId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
      }

      match /blockedContacts/{contactUid} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
      }
    }
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /directChats/{chatId} {
      allow create: if signedIn()
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 50
        && request.auth.uid in request.resource.data.memberIds
        && (request.resource.data.type == 'direct'
          || request.resource.data.createdBy == request.auth.uid);
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['lastMessage', 'lastAuthorId', 'updatedAt', 'unreadCounts']
          )
          || (
            resource.data.type == 'group'
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['roles', 'access', 'avatarBase64']
            )
          )
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.memberIds;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.memberIds
          && request.resource.data.authorId == request.auth.uid;
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.auth.uid in request.resource.data.readBy;
        allow delete: if false;
      }

      match /typing/{uid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.memberIds;
        allow create, update, delete: if signedIn()
          && uid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.memberIds;
      }
    }
    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }
    match /taskBoards/{boardId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.access[request.auth.uid] == 'full';
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && resource.data.access[request.auth.uid] in ['edit', 'full'];
      allow delete: if signedIn()
        && resource.data.access[request.auth.uid] == 'full';

      match /tasks/{taskId} {
        function board() {
          return get(/databases/$(database)/documents/taskBoards/$(boardId)).data;
        }

        allow read: if signedIn()
          && request.auth.uid in board().memberIds;
        allow create: if signedIn()
          && request.auth.uid in board().memberIds
          && board().access[request.auth.uid] in ['edit', 'full']
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if signedIn()
          && request.auth.uid in board().memberIds
          && board().access[request.auth.uid] in ['edit', 'full'];
        allow delete: if signedIn()
          && request.auth.uid in board().memberIds
          && (board().access[request.auth.uid] == 'full'
            || resource.data.createdBy == request.auth.uid);
      }
    }
    match /teams/{teamId} {
      allow read: if member(teamId);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if false;

      match /members/{uid} {
        allow read: if member(teamId);
        allow create, update: if signedIn()
          && uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == request.auth.uid;
        allow delete: if false;
      }
    }
  }
}
